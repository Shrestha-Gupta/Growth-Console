# =============================================================
# Growth Console — Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# =============================================================

# Server
NODE_ENV=development
PORT=5000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# MongoDB
# Format: mongodb://[user:password@]host:port/database
# Local:  mongodb://localhost:27017/growth_console
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/growth_console
MONGODB_URI=mongodb://localhost:27017/growth_console

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=8h

# Cookie
COOKIE_SECRET=replace_with_another_long_random_secret

# Admin Seed — credentials for the initial administrator account
# Used by:  npm run seed:admin
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@yourorg.com
ADMIN_SEED_PASSWORD=replace_with_a_strong_password
