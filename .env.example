# =============================================================
# Growth Console — Global Environment Reference
# Organization: Growth Tech India
# =============================================================

# Server Environment
NODE_ENV=development
PORT=5000

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# Database Connection (MongoDB Standalone, Replica Set, or Atlas)
MONGODB_URI=mongodb://localhost:27017/growth_console

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_min_64_characters
JWT_EXPIRES_IN=8h

# Cookie & CSRF HMAC Signing
COOKIE_SECRET=replace_with_a_secure_cookie_hmac_secret_key

# Initial Administrator Seed Credentials
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@growthconsole.internal
ADMIN_SEED_PASSWORD=replace_with_a_strong_password
